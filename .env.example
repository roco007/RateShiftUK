# RateShift UK Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Authentication
# ===========================================

# Google OAuth Client ID (for Google Sign-In)
# Get yours at: https://console.cloud.google.com/apis/credentials
# Must be a Web Application type with your domain in Authorized JavaScript origins
VITE_GOOGLE_CLIENT_ID=

# ===========================================
# AI Providers (optional - app works without them in Mock mode)
# ===========================================

# OpenAI API Key (for GPT-powered email generation)
# Get yours at: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (FREE tier available!)
# Get yours at: https://aistudio.google.com/apikey
# All Gemini Flash models are FREE on the developer tier
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.8-flash

# Available FREE Gemini models (as of 2026):
# - gemini-3.8-flash      (Most intelligent Flash – RECOMMENDED)
# - gemini-3.7-flash      (High-speed, efficient)
# - gemini-3.6-flash      (Previous gen, balanced)
# - gemini-3.5-flash-lite (Cost-efficient, high-volume)
# - gemini-3.1-flash-lite (Fastest, smallest)
# - gemini-2.5-pro        (Complex reasoning, 1M context)
# - gemini-2.5-flash      (Hybrid reasoning, 1M context)
# - gemini-2.5-flash-lite (Smallest, fastest)

# ===========================================
# Email Configuration (EmailJS)
# ===========================================

# EmailJS allows sending emails directly from the browser
# Get your credentials at: https://www.emailjs.com/ (free tier: 200 emails/month)
# 
# Setup steps:
# 1. Sign up at emailjs.com
# 2. Add your email service (Gmail, Outlook, etc.)
# 3. Create an email template with variables: {{to_email}}, {{to_name}}, {{subject}}, {{message}}
# 4. Copy your credentials below
#
# Note: These can also be configured in the Settings page of the app
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
